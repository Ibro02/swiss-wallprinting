{
  "name": "swiss-wallprinting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-mock.ts && node scripts/check-mail.ts && next build",
    "start": "next start",
    "check": "vp check",
    "test": "vp test",
    "models": "node scripts/optimize-models.ts",
    "images": "node scripts/images.ts",
    "prepare": "vp config --no-agent && next typegen",
    "typegen": "next typegen",
    "mockups": "node scripts/mockups.ts",
    "frames": "node scripts/frames.ts",
    "mail:test": "node --env-file-if-exists=.env.local scripts/send-test-mail.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "10.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.14.0"
}
