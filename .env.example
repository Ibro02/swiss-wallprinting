# Copy to .env.local (git ignores it) and fill in. On the host, set the same
# variables in its settings. Never put real values in git.

# Recipient of all form messages. During development: the author's own address.
# Before launch: the client's mailbox.
CONTACT_TO=

# "production" only for the launch build: the build then fails while mock content
# exists or the mail settings are missing.
SITE_ENV=

# Public address of this deployment, for canonical and hreflang links.
# Default: https://www.swisswallprinting.ch
SITE_URL=

# Proxies in front of the site that add to X-Forwarded-For (the form send limit counts
# per visitor IP, src/lib/request.ts). Default 1: Vercel, or one nginx/Caddy. Set 2 with,
# for example, Cloudflare in front of nginx.
TRUSTED_PROXY_HOPS=

# How form e-mails are sent: "outbox" (development: files in .mail-outbox/),
# "smtp", or "resend". Test with `vp run mail:test`.
MAIL_TRANSPORT=
# Sender shown in the e-mail, e.g. "Swiss Wall Printing <sito@swisswallprinting.ch>".
# For SMTP, use an address of the mailbox below; for Resend, an address on a verified domain.
MAIL_FROM=

# SMTP (MAIL_TRANSPORT=smtp). Port 587 uses STARTTLS, 465 uses TLS (SMTP_SECURE=true).
# Gmail: smtp.gmail.com, your address, and an app password (needs 2-step verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Resend (MAIL_TRANSPORT=resend): the API key from resend.com.
RESEND_API_KEY=
